MDScreen:
    md_bg_color: 0.95, 0.95, 0.97, 1

    MDBoxLayout:
        orientation: 'vertical'
        padding: "16dp"
        spacing: "16dp"

        MDTopAppBar:
            title: "Локальный Редактор (RAM)"
            elevation: 2
            pos_hint: {"top": 1}
            right_action_items: [["info", lambda x: app.show_info_menu()]]

        MDLabel:
            id: status_label
            text: "Выберите файл. Изменения перезапишут документ на телефоне."
            halign: "center"
            theme_text_color: "Secondary"
            size_hint_y: None
            height: "40dp"

        ScrollView:
            do_scroll_x: False
            do_scroll_y: True
            bar_width: "4dp"

            MDTextField:
                id: file_content_view
                text: ""
                multiline: True
                readonly: False
                mode: "rectangle"
                hint_text: "Содержимое документа отобразится здесь"

        MDBoxLayout:
            orientation: 'horizontal'
            spacing: "12dp"
            size_hint_y: None
            height: "50dp"

            MDFillRoundFlatIconButton:
                text: "ОТКРЫТЬ ФАЙЛ"
                icon: "file-find"
                size_hint_x: 0.5
                on_release: app.open_system_storage()

            MDFillRoundFlatIconButton:
                id: save_btn
                text: "СОХРАНИТЬ"
                icon: "content-save"
                md_bg_color: 0.1, 0.6, 0.3, 1
                size_hint_x: 0.5
                disabled: True
                on_release: app.save_changes_to_storage()
