MDScreen:
    md_bg_color: (0.955, 0.967, 0.985, 1) if app.theme_cls.theme_style == 'Light' else (0.035, 0.055, 0.09, 1)

    FloatLayout:
        MDBoxLayout:
            orientation: "vertical"
            padding: ["16dp", "8dp", "16dp", "12dp"]
            spacing: "12dp"

            MDTopAppBar:
                id: app_title
                title: "Лист"
                elevation: 0
                md_bg_color: (0.955, 0.967, 0.985, 1) if app.theme_cls.theme_style == 'Light' else (0.035, 0.055, 0.09, 1)
                specific_text_color: (0.10, 0.16, 0.25, 1) if app.theme_cls.theme_style == 'Light' else (0.94, 0.96, 1, 1)
                right_action_items: [["magnify", lambda x: app.open_system_storage()], ["cog-outline", lambda x: app.show_settings_menu()], ["dots-vertical", lambda x: app.show_info_menu()]]

            MDCard:
                orientation: "vertical"
                padding: ["18dp", "18dp", "18dp", "16dp"]
                spacing: "8dp"
                size_hint_y: None
                height: "158dp"
                radius: [26, 26, 26, 26]
                elevation: 3
                md_bg_color: (0.075, 0.24, 0.20, 1) if app.theme_cls.theme_style == 'Light' else (0.08, 0.20, 0.18, 1)

                MDLabel:
                    text: "ВАШЕ ПРОСТРАНСТВО"
                    font_style: "Overline"
                    theme_text_color: "Custom"
                    text_color: 0.72, 0.88, 0.80, 1
                    size_hint_y: None
                    height: "22dp"

                MDLabel:
                    id: workspace_title
                    text: "Всё для ваших идей"
                    font_style: "H5"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1
                    size_hint_y: None
                    height: "42dp"

                MDLabel:
                    id: status_label
                    text: "Документы, таблицы и презентации — в одном месте"
                    font_style: "Body2"
                    theme_text_color: "Custom"
                    text_color: 0.86, 0.93, 0.89, 1
                    size_hint_y: None
                    height: "38dp"

            MDBoxLayout:
                orientation: "horizontal"
                size_hint_y: None
                height: "94dp"
                spacing: "10dp"

                MDCard:
                    orientation: "vertical"
                    padding: "10dp"
                    spacing: "4dp"
                    radius: [20, 20, 20, 20]
                    elevation: 1
                    md_bg_color: app.theme_cls.bg_normal
                    MDIconButton:
                        icon: "file-document-edit-outline"
                        theme_text_color: "Custom"
                        text_color: 0.16, 0.55, 0.42, 1
                        on_release: app.create_new_document("docx")
                    MDLabel:
                        text: "Документ"
                        halign: "center"
                        font_style: "Caption"
                        theme_text_color: "Primary"

                MDCard:
                    orientation: "vertical"
                    padding: "10dp"
                    spacing: "4dp"
                    radius: [20, 20, 20, 20]
                    elevation: 1
                    md_bg_color: app.theme_cls.bg_normal
                    MDIconButton:
                        icon: "microsoft-excel"
                        theme_text_color: "Custom"
                        text_color: 0.16, 0.55, 0.42, 1
                        on_release: app.create_new_document("xlsx")
                    MDLabel:
                        text: "Таблица"
                        halign: "center"
                        font_style: "Caption"
                        theme_text_color: "Primary"

                MDCard:
                    orientation: "vertical"
                    padding: "10dp"
                    spacing: "4dp"
                    radius: [20, 20, 20, 20]
                    elevation: 1
                    md_bg_color: app.theme_cls.bg_normal
                    MDIconButton:
                        icon: "presentation"
                        theme_text_color: "Custom"
                        text_color: 0.16, 0.55, 0.42, 1
                        on_release: app.create_new_document("pptx")
                    MDLabel:
                        text: "Слайды"
                        halign: "center"
                        font_style: "Caption"
                        theme_text_color: "Primary"

                MDCard:
                    orientation: "vertical"
                    padding: "10dp"
                    spacing: "4dp"
                    radius: [20, 20, 20, 20]
                    elevation: 1
                    md_bg_color: app.theme_cls.bg_normal
                    MDIconButton:
                        icon: "file-pdf-box"
                        theme_text_color: "Custom"
                        text_color: 0.16, 0.55, 0.42, 1
                        on_release: app.open_system_storage()
                    MDLabel:
                        text: "PDF"
                        halign: "center"
                        font_style: "Caption"
                        theme_text_color: "Primary"

            MDBoxLayout:
                orientation: "horizontal"
                size_hint_y: None
                height: "34dp"
                MDLabel:
                    text: "Недавние файлы"
                    font_style: "H6"
                    bold: True
                    theme_text_color: "Primary"
                MDLabel:
                    text: "НА УСТРОЙСТВЕ"
                    halign: "right"
                    font_style: "Overline"
                    theme_text_color: "Secondary"

            ScrollView:
                size_hint_y: 1
                do_scroll_x: False
                bar_width: "3dp"
                MDBoxLayout:
                    id: documents_list
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: "8dp"
                    padding: ["0dp", "2dp", "0dp", "8dp"]

            MDCard:
                id: editor_card
                orientation: "vertical"
                size_hint_y: None
                height: "0dp"
                opacity: 0
                padding: "12dp"
                radius: [22, 22, 22, 22]
                elevation: 2
                md_bg_color: app.theme_cls.bg_normal
                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: "36dp"
                    spacing: "8dp"
                    MDIcon:
                        icon: "file-edit-outline"
                        theme_text_color: "Custom"
                        text_color: 0.16, 0.55, 0.42, 1
                        size_hint_x: None
                        width: "28dp"
                    MDLabel:
                        id: editor_title
                        text: "Редактор документов"
                        font_style: "Subtitle1"
                        bold: True
                        theme_text_color: "Primary"
                ScrollView:
                    do_scroll_x: False
                    do_scroll_y: True
                    bar_width: "3dp"
                    MDTextField:
                        id: file_content_view
                        text: ""
                        multiline: True
                        readonly: True
                        focus: False
                        mode: "rectangle"
                        size_hint_y: None
                        height: max(self.minimum_height, root.height * 0.56)
                        hint_text: "Текст документа"
                        font_size: "16sp"
                        line_color_focus: 0.16, 0.55, 0.42, 1

            MDBoxLayout:
                orientation: "horizontal"
                spacing: "8dp"
                size_hint_y: None
                height: "56dp"

                MDFillRoundFlatIconButton:
                    id: create_btn
                    text: "Создать"
                    icon: "plus"
                    on_release: app.show_new_document_menu()
                    size_hint_x: 0.34
                    md_bg_color: 0.12, 0.48, 0.36, 1

                MDFillRoundFlatIconButton:
                    id: open_btn
                    text: "Открыть"
                    icon: "folder-open-outline"
                    on_release: app.open_system_storage()
                    size_hint_x: 0.30
                    md_bg_color: 0.16, 0.48, 0.62, 1

                MDFillRoundFlatIconButton:
                    text: "Папка"
                    icon: "folder-plus-outline"
                    on_release: app.request_folder_access()
                    size_hint_x: 0.20
                    md_bg_color: 0.30, 0.40, 0.56, 1

                MDFillRoundFlatIconButton:
                    id: save_btn
                    text: "Сохранить"
                    icon: "content-save-outline"
                    on_release: app.save_changes_to_storage()
                    disabled: True
                    size_hint_x: 0.32
                    md_bg_color: 0.20, 0.42, 0.34, 1

        MDCard:
            id: splash_layer
            radius: [0, 0, 0, 0]
            elevation: 0
            size_hint: 1, 1
            pos: 0, 0
            opacity: 1
            md_bg_color: 1, 1, 1, 1
            FloatLayout:
                Image:
                    source: "splash_leaf.jpg"
                    size_hint: 1, 1
                    pos_hint: {"x": 0, "y": 0}
                    allow_stretch: True
                    keep_ratio: False
