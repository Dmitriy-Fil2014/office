MDScreen:
    md_bg_color: (0.95, 0.97, 1, 1) if app.theme_cls.theme_style == 'Light' else (0.055, 0.075, 0.12, 1)

    FloatLayout:
        MDBoxLayout:
            orientation: "vertical"
            padding: "16dp"
            spacing: "14dp"

            MDTopAppBar:
                id: app_title
                title: "Лист"
                elevation: 0
                md_bg_color: 0.95, 0.97, 1, 1
                specific_text_color: (0.10, 0.18, 0.30, 1) if app.theme_cls.theme_style == 'Light' else (0.95, 0.97, 1, 1)
                right_action_items: [["image-plus", lambda x: app.add_picture_to_document()], ["table-plus", lambda x: app.add_table_to_word()], ["plus-box", lambda x: app.add_slide_to_presentation()], ["cog", lambda x: app.show_settings_menu()], ["shield-check", lambda x: app.show_info_menu()]]

            MDCard:
                orientation: "vertical"
                padding: "18dp"
                spacing: "6dp"
                size_hint_y: None
                height: "112dp"
                radius: [22, 22, 22, 22]
                elevation: 2
                md_bg_color: app.theme_cls.bg_normal

                MDLabel:
                    id: workspace_title
                    text: "Ваше рабочее пространство"
                    font_style: "H6"
                    bold: True
                    theme_text_color: "Primary"
                    size_hint_y: None
                    height: "34dp"

                MDLabel:
                    id: status_label
                    text: "Создавайте и редактируйте документы на устройстве"
                    theme_text_color: "Secondary"
                    font_style: "Body2"
                    size_hint_y: None
                    height: "42dp"

            ScrollView:
                size_hint_y: 1
                do_scroll_x: False
                bar_width: "3dp"
                MDBoxLayout:
                    id: documents_list
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: "6dp"
                    padding: "2dp"

            MDCard:
                id: editor_card
                orientation: "vertical"
                size_hint_y: None
                height: "0dp"
                opacity: 0
                padding: "12dp"
                radius: [22, 22, 22, 22]
                elevation: 2
                md_bg_color: 1, 1, 1, 1

                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: "36dp"
                    spacing: "8dp"
                    MDLabel:
                        text: "✎"
                        font_style: "H6"
                        theme_text_color: "Custom"
                        text_color: 0.12, 0.48, 0.88, 1
                        size_hint_x: None
                        width: "28dp"
                    MDLabel:
                        id: editor_title
                        text: "Редактор документов"
                        font_style: "Subtitle1"
                        bold: True
                        theme_text_color: "Primary"

                ScrollView:
                    do_scroll_x: False
                    do_scroll_y: True
                    bar_width: "3dp"
                    MDTextField:
                        id: file_content_view
                        text: ""
                        multiline: True
                        mode: "rectangle"
                        size_hint_y: None
                        height: max(self.minimum_height, root.height * 0.56)
                        hint_text: "Откройте документ или создайте новый…"
                        font_size: "16sp"
                        line_color_focus: 0.12, 0.48, 0.88, 1

            MDBoxLayout:
                orientation: "horizontal"
                spacing: "8dp"
                size_hint_y: None
                height: "54dp"

                MDFillRoundFlatIconButton:
                    id: create_btn
                    text: "Создать"
                    icon: "plus-circle"
                    on_release: app.show_new_document_menu()
                    size_hint_x: 0.33
                    md_bg_color: 0.12, 0.48, 0.88, 1

                MDFillRoundFlatIconButton:
                    id: open_btn
                    text: "Открыть"
                    icon: "folder-open"
                    on_release: app.open_system_storage()
                    size_hint_x: 0.25
                    md_bg_color: 0.16, 0.60, 0.68, 1

                MDFillRoundFlatIconButton:
                    text: "Папка"
                    icon: "folder-plus"
                    on_release: app.request_folder_access()
                    size_hint_x: 0.25
                    md_bg_color: 0.35, 0.48, 0.70, 1

                MDFillRoundFlatIconButton:
                    id: save_btn
                    text: "Сохранить"
                    icon: "content-save"
                    on_release: app.save_changes_to_storage()
                    disabled: True
                    size_hint_x: 0.25
                    md_bg_color: 0.30, 0.38, 0.52, 1

        MDCard:
            id: splash_layer
            orientation: "vertical"
            radius: [0, 0, 0, 0]
            elevation: 0
            spacing: "18dp"
            padding: "32dp"
            size_hint: 1, 1
            pos: 0, 0
            opacity: 1
            md_bg_color: 0.08, 0.32, 0.66, 1
            Widget:
                size_hint_y: 1
            MDLabel:
                text: "Загрузка"
                halign: "center"
                valign: "middle"
                font_style: "H5"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                size_hint_y: None
                height: "64dp"
            Widget:
                size_hint_y: 1
